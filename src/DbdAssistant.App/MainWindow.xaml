<Window x:Class="DbdAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBD Assistant" Width="900" Height="640"
        Background="#1b1b1f" Foreground="#e8e8ea">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SaveButton" Content="Enregistrer une capture" Padding="12,6" Click="SaveButton_Click"/>
            <TextBlock Text="HUD :" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModeBox" Width="100" Margin="6,0,0,0" SelectionChanged="ModeBox_Changed" ToolTip="Tueur : tu joues le tueur. Survivant : tu joues un survivant (le HUD n'est pas le meme).">
                <ComboBoxItem Content="Tueur"/>
                <ComboBoxItem Content="Survivant"/>
            </ComboBox>
            <CheckBox x:Name="OverlayBox" Content="Overlay" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#e8e8ea" Checked="OverlayBox_Changed" Unchecked="OverlayBox_Changed" ToolTip="Affiche les etats par-dessus le jeu (mode fenetre sans bordure)."/>
            <Button x:Name="CalibrateButton" Content="Calibrer les portraits" Padding="12,6" Margin="16,0,0,0" Click="CalibrateButton_Click"/>
            <TextBlock x:Name="InfoText" Margin="16,0,0,0" VerticalAlignment="Center" Text="Demarrage..."/>
        </StackPanel>
        <TextBlock x:Name="WarningText" DockPanel.Dock="Top" Foreground="#ffb454" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <UniformGrid x:Name="Cards" DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0,0,0,10"/>
        <Image x:Name="Preview" Stretch="Uniform"/>
    </DockPanel>
</Window>
